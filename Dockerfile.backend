FROM python:3.13-slim

WORKDIR /backend

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget xz-utils && \
    rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN wget -q https://github.com/official-stockfish/Stockfish/releases/download/sf_16/stockfish-ubuntu-x86-64-avx2.tar.xz && \
    tar -xJf stockfish-ubuntu-x86-64-avx2.tar.xz && \
    mv stockfish-ubuntu-x86-64-avx2 /backend/stockfish && \
    rm stockfish-ubuntu-x86-64-avx2.tar.xz && \
    chmod +x /backend/stockfish

COPY backend/main.py /backend/main.py

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]